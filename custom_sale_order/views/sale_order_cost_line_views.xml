<odoo>
    <record id="view_sale_order_cost_line_form" model="ir.ui.view">
        <field name="name">sale.order.cost.line.form</field>
        <field name="model">sale.order.cost.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="user_id"/>
                    <field name="amount"/>
                    <field name="state"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sale_order_cost_line_tree" model="ir.ui.view">
        <field name="name">sale.order.cost.line.tree</field>
        <field name="model">sale.order.cost.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="user_id"/>
                <field name="amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_order_form_inherit_cost_line" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cost.line</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <group string="Chi phí đơn hàng">
                    <field name="cost_line_ids" mode="tree,form" context="{'default_order_id': active_id}">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="user_id"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </tree>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="user_id"/>
                                <field name="amount"/>
                                <field name="state"/>
                            </group>
                        </form>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo> 