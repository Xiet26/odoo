<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_internal_note" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.internal.note</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']/group/group[@name='sales_person']" position="inside">
                <field name="internal_note"/>
            </xpath>
        </field>
    </record>
</odoo>
