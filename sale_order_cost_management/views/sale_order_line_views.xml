<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Sale Order Line Costing -->
    <record id="sale_order_line_view_tree_costing" model="ir.ui.view">
        <field name="name">sale.order.line.tree.costing</field>
        <field name="model">sale.order.line</field>
        <field name="type">list</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Order Lines Costing" create="false" edit="false">
                <field name="product_id"/>
                <field name="product_uom_qty" string="Ordered Qty"/>
                <field name="cost_price" string="Cost Price"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="total_cost" string="Total Cost"/>
                <field name="price_subtotal" string="Subtotal"/>
                <field name="line_margin" string="Margin"/>
                <field name="product_warranty" string="Warranty"/>
            </list>
        </field>
    </record>

    <!-- Test view with minimal fields -->
    <record id="sale_order_line_view_tree_costing_test" model="ir.ui.view">
        <field name="name">sale.order.line.tree.costing.test</field>
        <field name="model">sale.order.line</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Test Costing View">
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="cost_price"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>

    <!-- Inherit Sale Order Line Form View to add cost fields -->
    <record id="view_order_line_form_inherit_cost" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.cost</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="cost_price" string="Cost Price"/>
                <field name="total_cost" string="Total Cost"/>
                <field name="line_margin" string="Margin"/>
                <field name="product_warranty" string="Warranty"/>
            </xpath>
        </field>
    </record>
</odoo>
