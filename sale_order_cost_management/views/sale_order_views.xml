<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order Form View to add Costs tab -->
    <record id="view_order_form_inherit_costs" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.costs</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Costs" name="order_costs">
                    <field name="cost_ids"/>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_cost"/>
                    </group>
                </page>
                <page string="Costing" name="order_costing">
                    <field name="order_line" context="{'tree_view_ref': 'sale_order_cost_management.sale_order_line_view_tree_costing'}" readonly="1"/>
                </page>
                <page string="Summary" name="order_summary">
                    <group class="oe_subtotal_footer oe_right" name="summary_total">
                        <field name="amount_total" string="Total Revenue"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <span class="o_form_label">Costs Breakdown:</span>
                        </div>
                        <field name="order_lines_cost" string="• Product Costs"/>
                        <field name="total_cost" string="• Additional Costs"/>
                        <field name="total_all_costs" string="Total All Costs"/>
                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                            <label for="final_profit" string="Final Profit"/>
                        </div>
                        <field name="final_profit" nolabel="1" class="oe_subtotal_footer_separator"/>
                    </group>
                </page>
                <page string="Vị trí hàng trong kho" name="stock_location_info">
                    <field name="stock_location_info"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sale Order Form View to add warranty column to order lines -->
    <record id="view_order_form_inherit_warranty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='price_subtotal']" position="after">
                <field name="product_warranty" string="Warranty" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>