<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View for Sale Order Costs -->
    <record id="sale_order_cost_view_tree" model="ir.ui.view">
        <field name="name">sale.order.cost.tree</field>
        <field name="model">sale.order.cost</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'paid'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View for Sale Order Costs -->
    <record id="sale_order_cost_view_form" model="ir.ui.view">
        <field name="name">sale.order.cost.form</field>
        <field name="model">sale.order.cost</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pay" string="Mark as Paid" type="object" class="oe_highlight" invisible="state == 'paid'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="order_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
