<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_social_float_tree" model="ir.ui.view">
        <field name="name">social.float.tree</field>
        <field name="model">social.float</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zalo_link"/>
                <field name="facebook_link"/>
                <field name="phone_number"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_social_float_form" model="ir.ui.view">
        <field name="name">social.float.form</field>
        <field name="model">social.float</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_active"/>
                            <field name="button_color"/>
                            <field name="icon_color"/>
                        </group>
                        <group>
                            <field name="zalo_link"/>
                            <field name="facebook_link"/>
                            <field name="phone_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Icons">
                            <group>
                                <field name="zalo_icon"/>
                                <field name="facebook_icon"/>
                                <field name="phone_icon"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_social_float" model="ir.actions.act_window">
        <field name="name">Social Float Buttons</field>
        <field name="res_model">social.float</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_social_float"
        name="Social Float"
        action="action_social_float"
        parent="website.menu_website_configuration"
        sequence="100"/>
</odoo> 