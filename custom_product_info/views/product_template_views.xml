<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions -->
    <record id="action_product_manufacturer" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">product.manufacturer</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_product_warranty" model="ir.actions.act_window">
        <field name="name">Warranties</field>
        <field name="res_model">product.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first warranty!
            </p>
            <p>
                Define different warranty types with their durations.
            </p>
        </field>
    </record>

    <record id="action_product_origin" model="ir.actions.act_window">
        <field name="name">Origins</field>
        <field name="res_model">product.origin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first country of origin!
            </p>
            <p>
                Define countries of origin with their codes.
            </p>
        </field>
    </record>

    <record id="action_product_faq" model="ir.actions.act_window">
        <field name="name">FAQs</field>
        <field name="res_model">product.faq</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_product_attributes"
              name="Product Attributes"
              parent="sale.product_menu_catalog"
              sequence="5"/>

    <menuitem id="menu_product_manufacturer"
              name="Manufacturers"
              parent="menu_product_attributes"
              action="action_product_manufacturer"
              sequence="1"/>

    <menuitem id="menu_product_warranty"
              name="Warranties"
              parent="menu_product_attributes"
              action="action_product_warranty"
              sequence="2"/>

    <menuitem id="menu_product_origin"
              name="Origins"
              parent="menu_product_attributes"
              action="action_product_origin"
              sequence="3"/>

    <menuitem id="menu_product_faq"
              name="FAQs"
              parent="menu_product_attributes"
              action="action_product_faq"
              sequence="10"/>

    <!-- Manufacturer views -->
    <record id="view_product_manufacturer_kanban" model="ir.ui.view">
        <field name="name">product.manufacturer.kanban</field>
        <field name="model">product.manufacturer</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_manufacturer_form" model="ir.ui.view">
        <field name="name">product.manufacturer.form</field>
        <field name="model">product.manufacturer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                    <group string="Additional Information">
                        <field name="logo" widget="image" class="oe_avatar"/> <!-- Hiển thị logo -->
                        <field name="x_slug" readonly="1"/> <!-- Hiển thị slug (chỉ đọc) -->
                        <field name="content" widget="html"/> <!-- Hiển thị nội dung HTML -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_manufacturer_list" model="ir.ui.view">
        <field name="name">product.manufacturer.list</field>
        <field name="model">product.manufacturer</field>
        <field name="arch" type="xml">
            <list >
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Warranty views -->
    <record id="view_product_warranty_kanban" model="ir.ui.view">
        <field name="name">product.warranty.kanban</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="duration"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="duration"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_warranty_search" model="ir.ui.view">
        <field name="name">product.warranty.search</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="duration"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Duration" name="group_by_duration" context="{'group_by': 'duration'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_product_warranty_form" model="ir.ui.view">
        <field name="name">product.warranty.form</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Standard Warranty"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_warranty_list" model="ir.ui.view">
        <field name="name">product.warranty.list</field>
        <field name="model">product.warranty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="duration"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Origin views -->
    <record id="view_product_origin_kanban" model="ir.ui.view">
        <field name="name">product.origin.kanban</field>
        <field name="model">product.origin</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="code"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_product_origin_search" model="ir.ui.view">
        <field name="name">product.origin.search</field>
        <field name="model">product.origin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Country Code" name="group_by_code" context="{'group_by': 'code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_product_origin_form" model="ir.ui.view">
        <field name="name">product.origin.form</field>
        <field name="model">product.origin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Vietnam"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. VN"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_origin_list" model="ir.ui.view">
        <field name="name">product.origin.list</field>
        <field name="model">product.origin</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Product Category Form View -->
    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">product.category.form.inherit.custom.info</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="x_logo" widget="image" class="oe_avatar"/>
                <field name="x_content" widget="html"/>
                <field name="x_is_show_in_homepage"/>
                <field name="x_slug" readonly="1"/>
                <field name="blog_post_ids" widget="many2many_tags"/>
                <field name="x_product_attribute" widget="many2many_tags"/>
                <field name="x_name"/>  
            </field>
        </field>
    </record>

    <!-- Product Template Form View -->
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.custom.info</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Additional Information" name="custom_info">
                    <group>
                        <group string="Basic Information">
                            <field name="x_manufacturer_id" 
                                   options="{
                                       'no_create_edit': false,
                                       'no_create': false,
                                       'no_open': false,
                                       'quick_create': true
                                   }"
                                   context="{
                                       'form_view_ref': 'custom_product_info.view_product_manufacturer_form',
                                       'kanban_view_ref': 'custom_product_info.view_product_manufacturer_kanban'
                                   }"/>
                            <field name="categ_id"
                                   options="{
                                       'no_create_edit': false,
                                       'no_create': false,
                                       'no_open': false,
                                       'quick_create': true
                                   }"/>
                            <field name="x_model"/>
                            <field name="x_part_number"/>
                            <field name="x_internal_code" readonly="1"/>
                            <field name="x_always_available"/>
                            <field name="blog_new_tag" widget="many2many_tags"/>
                            <field name="blog_post_ids" widget="many2many_tags"/>
                            <field name="x_warranty_id"
                                   options="{
                                       'no_create_edit': false,
                                       'no_create': false,
                                       'no_open': false,
                                       'quick_create': true
                                   }"
                                   context="{
                                       'form_view_ref': 'custom_product_info.view_product_warranty_form',
                                       'kanban_view_ref': 'custom_product_info.view_product_warranty_kanban'
                                   }"/>
                            <field name="x_origin_id"
                                   options="{
                                       'no_create_edit': false,
                                       'no_create': false,
                                       'no_open': false,
                                       'quick_create': true
                                   }"
                                   context="{
                                       'form_view_ref': 'custom_product_info.view_product_origin_form',
                                       'kanban_view_ref': 'custom_product_info.view_product_origin_kanban'
                                   }"/>
                            <field name="x_customs_description"/>
                        </group>
                        <group string="Import Information">
                            <field name="x_custom_hs_code"/>
                            <field name="x_estimated_import_tax"/>
                        </group>
                    </group>
                    <group string="Technical Specifications">
                        <field name="x_specifications" placeholder="Enter specifications"/>
                    </group>
                    <group string="Package Contents">
                        <field name="x_package_includes" placeholder="Enter package contents"/>
                    </group>
                    <group string="Order Information">
                        <field name="x_order_information" placeholder="Enter order information"/>
                    </group>
                    <group string="YouTube Video">
                        <field name="x_youtube_video_url" placeholder="Paste YouTube video URL here"/>
                    </group>
                    <group string="Documents">
                        <field name="x_custom_document" filename="x_custom_document_filename"/>
                        <field name="x_custom_document_filename" invisible="1"/>
                        <field name="product_document_ids"
                               context="{'default_res_model': 'product.template', 'default_res_id': id}"
                               domain="[('res_model', '=', 'product.template'), ('res_id', '=', id)]"
                               widget="one2many"
                               string="Documents"/>
                    </group>
                    <group string="Configuration">
                        <!-- <field name="x_configuration_content" placeholder="Enter configuration content"/> -->
                    </group>
                    <group string="FAQs">
                        <field name="x_faq_ids" 
                            widget="one2many" 
                            context="{'default_product_tmpl_ids': [(6, 0, [id])]}" 
                            domain="[('product_tmpl_ids', 'in', [id])]" 
                            string="FAQs"/>
                        <button name="action_create_faq" type="object" string="Create FAQ" class="btn-primary"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Product Product Form View: Add Configuration Content -->

    <!-- Website Product Template -->
    <template id="product_custom_specifications" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_full_description']" position="after">
            <div class="container mt-4">
                <!-- Product Details Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="p-3 border rounded shadow-sm bg-light">
                            <h4 class="text-primary mb-3">Product Details</h4>
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <strong>Manufacturer:</strong>
                                    <p class="text-muted mb-0" t-field="product.x_manufacturer_id"/>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <strong>Model:</strong>
                                    <p class="text-muted mb-0" t-field="product.x_model"/>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <strong>Warranty:</strong>
                                    <p class="text-muted mb-0" t-field="product.x_warranty_id"/>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <strong>Origin:</strong>
                                    <p class="text-muted mb-0" t-field="product.x_origin_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Specifications and Package Includes Section -->
                <div class="row">
                    <div class="col-md-6">
                        <div id="custom_x_specifications" class="p-3 border rounded shadow-sm bg-light">
                            <h4 class="text-primary mb-2">Technical Specifications</h4>
                            <p class="text-muted" t-field="product.x_specifications"/>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="custom_x_package_includes" class="p-3 border rounded shadow-sm bg-light">
                            <h4 class="text-primary mb-2">Package Includes</h4>
                            <p class="text-muted" t-field="product.x_package_includes"/>
                        </div>
                    </div>
                </div>

                <!-- Import Information Section -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="p-3 border rounded shadow-sm bg-light">
                            <h4 class="text-primary mb-3">Import Information</h4>
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <strong>HS Code:</strong>
                                    <p class="text-muted mb-0" t-field="product.x_custom_hs_code"/>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <strong>Estimated Import Tax:</strong>
                                    <p class="text-muted mb-0" t-field="product.x_estimated_import_tax"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customs Description Section -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="p-3 border rounded shadow-sm bg-light">
                            <h4 class="text-primary mb-3">Customs Description</h4>
                            <div class="customs-description-content">
                                <t t-raw="product.x_customs_description"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

